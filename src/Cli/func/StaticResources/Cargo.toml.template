[package]
name = "{PackageName}"
version = "0.1.0"
edition = "2024"

# Provisional. The Azure Functions Rust crates are not published yet, so these
# versions are placeholders. Point them at a path or git source until they are.
[dependencies]
azure-functions-rust-sdk = "0.1"
azure-functions-rust-worker = "0.1"
serde_json = "1"
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
